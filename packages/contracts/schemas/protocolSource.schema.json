{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "protocolSource",
  "additionalProperties": false,
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "repository": {
      "pattern": "^https://[^\\s]+$",
      "maxLength": 2048,
      "type": "string"
    },
    "version": {
      "format": "semver",
      "type": "string"
    },
    "commit": {
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$",
      "type": "string"
    },
    "files": {
      "minItems": 1,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "properties": {
          "path": {
            "minLength": 1,
            "maxLength": 4096,
            "format": "repo-path",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "repository",
    "version",
    "commit",
    "files"
  ]
}
