{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "generatedPlugin",
  "additionalProperties": false,
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "platform": {
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 64,
      "type": "string"
    },
    "adapterVersion": {
      "format": "semver",
      "type": "string"
    },
    "root": {
      "minLength": 1,
      "maxLength": 4096,
      "format": "repo-path",
      "type": "string"
    },
    "files": {
      "minItems": 1,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "properties": {
          "path": {
            "minLength": 1,
            "maxLength": 4096,
            "format": "repo-path",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ]
      }
    },
    "inputHash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "platform",
    "adapterVersion",
    "root",
    "files",
    "inputHash"
  ]
}
