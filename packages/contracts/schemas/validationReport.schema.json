{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "validationReport",
  "additionalProperties": false,
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "valid": {
      "type": "boolean"
    },
    "checks": {
      "minItems": 1,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "properties": {
          "code": {
            "pattern": "^[A-Z][A-Z0-9_]*$",
            "maxLength": 128,
            "type": "string"
          },
          "path": {
            "minLength": 1,
            "maxLength": 4096,
            "format": "repo-path",
            "type": "string"
          },
          "message": {
            "minLength": 1,
            "maxLength": 4096,
            "type": "string"
          },
          "severity": {
            "anyOf": [
              {
                "const": "info",
                "type": "string"
              },
              {
                "const": "warning",
                "type": "string"
              },
              {
                "const": "error",
                "type": "string"
              }
            ]
          }
        },
        "required": [
          "code",
          "path",
          "message",
          "severity"
        ]
      }
    },
    "inputHash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "evidenceRefs": {
      "minItems": 1,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "properties": {
          "schemaVersion": {
            "const": 1,
            "type": "number"
          },
          "path": {
            "minLength": 1,
            "maxLength": 4096,
            "format": "repo-path",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          }
        },
        "required": [
          "schemaVersion",
          "path",
          "sha256"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "valid",
    "checks",
    "inputHash",
    "evidenceRefs"
  ]
}
