{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "releaseManifest",
  "additionalProperties": false,
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "releaseVersion": {
      "format": "semver",
      "type": "string"
    },
    "coreProtocolVersion": {
      "const": 1,
      "type": "number"
    },
    "sourceCommit": {
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$",
      "type": "string"
    },
    "protocolSource": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1,
          "type": "number"
        },
        "repository": {
          "pattern": "^https://[^\\s]+$",
          "maxLength": 2048,
          "type": "string"
        },
        "version": {
          "format": "semver",
          "type": "string"
        },
        "commit": {
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$",
          "type": "string"
        },
        "files": {
          "minItems": 1,
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "properties": {
              "path": {
                "minLength": 1,
                "maxLength": 4096,
                "format": "repo-path",
                "type": "string"
              },
              "sha256": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              }
            },
            "required": [
              "path",
              "sha256"
            ]
          }
        }
      },
      "required": [
        "schemaVersion",
        "repository",
        "version",
        "commit",
        "files"
      ]
    },
    "adapterCompatibility": {
      "minItems": 1,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "properties": {
          "platform": {
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "maxLength": 64,
            "type": "string"
          },
          "adapterVersion": {
            "format": "semver",
            "type": "string"
          },
          "coreProtocolVersion": {
            "const": 1,
            "type": "number"
          },
          "targetVersion": {
            "minLength": 1,
            "maxLength": 4096,
            "type": "string"
          }
        },
        "required": [
          "platform",
          "adapterVersion",
          "coreProtocolVersion",
          "targetVersion"
        ]
      }
    },
    "artifacts": {
      "minItems": 1,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "properties": {
          "schemaVersion": {
            "const": 1,
            "type": "number"
          },
          "platform": {
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "maxLength": 64,
            "type": "string"
          },
          "variant": {
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "maxLength": 64,
            "type": "string"
          },
          "version": {
            "format": "semver",
            "type": "string"
          },
          "coreProtocolVersion": {
            "const": 1,
            "type": "number"
          },
          "file": {
            "minLength": 1,
            "maxLength": 4096,
            "format": "repo-path",
            "type": "string"
          },
          "mediaType": {
            "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+$",
            "maxLength": 255,
            "type": "string"
          },
          "size": {
            "minimum": 0,
            "maximum": 9007199254740991,
            "type": "integer"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "inputHash": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          }
        },
        "required": [
          "schemaVersion",
          "platform",
          "variant",
          "version",
          "coreProtocolVersion",
          "file",
          "mediaType",
          "size",
          "sha256",
          "inputHash"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "releaseVersion",
    "coreProtocolVersion",
    "sourceCommit",
    "protocolSource",
    "adapterCompatibility",
    "artifacts"
  ]
}
