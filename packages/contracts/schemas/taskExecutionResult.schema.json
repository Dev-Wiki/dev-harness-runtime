              "minItems": 4,
              "type": "array",
              "items": {
                "additionalProperties": false,
                "type": "object",
                "properties": {
                  "path": {
                    "minLength": 1,
                    "maxLength": 4096,
                    "format": "repo-path",
                    "type": "string"
                  },
                  "beforeHash": {
                    "anyOf": [
                      {
                        "pattern": "^[a-f0-9]{64}$",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "afterHash": {
                    "anyOf": [
                      {
                        "pattern": "^[a-f0-9]{64}$",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "path",
                  "beforeHash",
                  "afterHash"
                ]
              }
            }
          },
          "required": [
            "schemaVersion",
            "taskId",
            "taskPath",
            "archivePath",
            "archiveIndexPath",
            "dashboardPath",
            "summary",
            "changes"
          ]
        }
      },
      "required": [
        "schemaVersion",
        "runId",
        "taskId",
        "attempt",
        "requestId",
        "snapshotHash",
        "summary",
        "verification",
        "changedFiles",
        "outcome",
        "needsPlanning",
        "reason"
      ]
    }
  ]
}
