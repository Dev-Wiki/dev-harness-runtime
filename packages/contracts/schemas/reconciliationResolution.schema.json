{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "reconciliationResolution",
  "additionalProperties": false,
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "runId": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "type": "string"
    },
    "expectedRevision": {
      "minimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "currentSnapshotRef": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1,
          "type": "number"
        },
        "path": {
          "minLength": 1,
          "maxLength": 4096,
          "format": "repo-path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "path",
        "sha256"
      ]
    },
    "currentSnapshotHash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "resolvedBy": {
      "minLength": 1,
      "maxLength": 4096,
      "type": "string"
    },
    "disposition": {
      "minLength": 1,
      "maxLength": 4096,
      "type": "string"
    },
    "taskIds": {
      "minItems": 1,
      "uniqueItems": true,
      "type": "array",
      "items": {
        "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$",
        "type": "string"
      }
    },
    "evidenceRefs": {
      "minItems": 1,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "properties": {
          "schemaVersion": {
            "const": 1,
            "type": "number"
          },
          "path": {
            "minLength": 1,
            "maxLength": 4096,
            "format": "repo-path",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          }
        },
        "required": [
          "schemaVersion",
          "path",
          "sha256"
        ]
      }
    },
    "createdAt": {
      "format": "utc-timestamp",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "expectedRevision",
    "currentSnapshotRef",
    "currentSnapshotHash",
    "resolvedBy",
    "disposition",
    "taskIds",
    "evidenceRefs",
    "createdAt"
  ]
}
