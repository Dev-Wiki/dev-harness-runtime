{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "lockMetadata",
  "additionalProperties": false,
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "ownerToken": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "type": "string"
    },
    "runId": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "type": "string"
    },
    "pid": {
      "minimum": 1,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "processStartIdentity": {
      "minLength": 1,
      "maxLength": 4096,
      "type": "string"
    },
    "adapter": {
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 64,
      "type": "string"
    },
    "repoRoot": {
      "minLength": 1,
      "maxLength": 4096,
      "format": "absolute-path",
      "type": "string"
    },
    "privateGitDir": {
      "minLength": 1,
      "maxLength": 4096,
      "format": "absolute-path",
      "type": "string"
    },
    "createdAt": {
      "format": "utc-timestamp",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "ownerToken",
    "runId",
    "pid",
    "adapter",
    "repoRoot",
    "privateGitDir",
    "createdAt"
  ]
}
