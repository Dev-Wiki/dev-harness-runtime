{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "verificationPlan",
  "additionalProperties": false,
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "sources": {
      "minItems": 1,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "properties": {
          "path": {
            "minLength": 1,
            "maxLength": 4096,
            "format": "repo-path",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ]
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "type": "string"
          },
          "acceptanceIds": {
            "minItems": 1,
            "uniqueItems": true,
            "type": "array",
            "items": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "type": "string"
            }
          },
          "argv": {
            "minItems": 1,
            "maxItems": 128,
            "type": "array",
            "items": {
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[^\\u0000]+$",
              "type": "string"
            }
          },
          "cwd": {
            "anyOf": [
              {
                "const": ".",
                "type": "string"
              },
              {
                "minLength": 1,
                "maxLength": 4096,
                "format": "repo-path",
                "type": "string"
              }
            ]
          },
          "writableArtifacts": {
            "uniqueItems": true,
            "type": "array",
            "items": {
              "minLength": 1,
              "maxLength": 4096,
              "format": "repo-path",
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "acceptanceIds",
          "argv",
          "cwd",
          "writableArtifacts"
        ]
      }
    },
    "manual": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "type": "string"
          },
          "acceptanceIds": {
            "minItems": 1,
            "uniqueItems": true,
            "type": "array",
            "items": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "type": "string"
            }
          },
          "description": {
            "minLength": 1,
            "maxLength": 4096,
            "type": "string"
          }
        },
        "required": [
          "id",
          "acceptanceIds",
          "description"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "sources",
    "commands",
    "manual"
  ]
}
