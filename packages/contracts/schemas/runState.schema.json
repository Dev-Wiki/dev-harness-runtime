      "const": 1,
      "type": "number"
    },
    "revision": {
      "minimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "runId": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "type": "string"
    },
    "adapter": {
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 64,
      "type": "string"
    },
    "status": {
      "anyOf": [
        {
          "const": "CREATED",
          "type": "string"
        },
        {
          "const": "RUNNING",
          "type": "string"
        },
        {
          "const": "BLOCKED",
          "type": "string"
        },
        {
          "const": "INTERRUPTED",
          "type": "string"
        },
        {
          "const": "FAILED",
          "type": "string"
        },
        {
          "const": "COMPLETED",
          "type": "string"
        }
      ]
    },
    "phase": {
      "anyOf": [
        {
          "const": "DISCOVERY",
          "type": "string"
        },
        {
          "const": "SELECT",
          "type": "string"
        },
        {
          "const": "SNAPSHOT",
          "type": "string"
        },
        {
          "const": "EXECUTE",
          "type": "string"
        },
        {
          "const": "REVALIDATE",
          "type": "string"
        },
        {
          "const": "FINALIZE",
          "type": "string"
        }
      ]
    },
