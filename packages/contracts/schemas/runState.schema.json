      "additionalProperties": false,
      "type": "object",
      "properties": {
        "repoRoot": {
          "minLength": 1,
          "maxLength": 4096,
          "format": "absolute-path",
          "type": "string"
        },
        "privateGitDir": {
          "minLength": 1,
          "maxLength": 4096,
          "format": "absolute-path",
          "type": "string"
        },
        "head": {
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$",
          "type": "string"
        },
        "branch": {
          "anyOf": [
            {
              "minLength": 1,
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "repoRoot",
        "privateGitDir",
        "head",
        "branch"
