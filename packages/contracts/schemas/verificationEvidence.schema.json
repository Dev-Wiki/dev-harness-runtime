          ]
        }
      },
      "required": [
        "schemaVersion",
        "runId",
        "taskId",
        "attempt",
        "requestId",
        "id",
        "acceptanceIds",
        "beforeSnapshotHash",
        "afterSnapshotHash",
        "startedAt",
        "finishedAt",
        "result",
        "kind",
        "reviewer",
        "confirmation"
      ]
    }
  ]
}
