            {
              "const": "failed",
              "type": "string"
            },
            {
              "const": "blocked",
              "type": "string"
            }
          ]
        },
        "kind": {
          "const": "manual",
          "type": "string"
        },
        "reviewer": {
          "minLength": 1,
          "maxLength": 4096,
          "type": "string"
        },
        "confirmation": {
          "additionalProperties": false,
          "type": "object",
          "properties": {
            "schemaVersion": {
              "const": 1,
