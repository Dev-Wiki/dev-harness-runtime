{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "hostEnvironment",
  "additionalProperties": false,
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "repoRoot": {
      "minLength": 1,
      "maxLength": 4096,
      "format": "absolute-path",
      "type": "string"
    },
    "privateGitDir": {
      "minLength": 1,
      "maxLength": 4096,
      "format": "absolute-path",
      "type": "string"
    },
    "os": {
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 64,
      "type": "string"
    },
    "architecture": {
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 64,
      "type": "string"
    },
    "nodeVersion": {
      "format": "semver",
      "type": "string"
    },
    "gitVersion": {
      "minLength": 1,
      "maxLength": 4096,
      "type": "string"
    },
    "hostExecutable": {
      "anyOf": [
        {
          "minLength": 1,
          "maxLength": 4096,
          "format": "absolute-path",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "targetVersion": {
      "minLength": 1,
      "maxLength": 4096,
      "type": "string"
    },
    "configHash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "repoRoot",
    "privateGitDir",
    "os",
    "architecture",
    "nodeVersion",
    "gitVersion",
    "hostExecutable",
    "targetVersion",
    "configHash"
  ]
}
