{
  "name": "dev-harness-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": "11.1.0"
  },
  "scripts": {
    "build": "tsc -b && node scripts/bundle-cli.mjs",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "oxlint packages build/targets build/transforms build/validators build/manifests build/tests scripts tests/integration tests/contract tests/packaging",
    "test": "pnpm build && node scripts/test.mjs",
    "test:fixtures": "node scripts/check-fixtures.mjs",
    "test:cli-package": "node scripts/check-cli-package.mjs",
    "verify:protocol": "node scripts/check-protocol.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm schemas:check && pnpm test:fixtures && pnpm test:cli-package",
    "clean": "node scripts/clean.mjs",
    "dhr": "node packages/cli/bin/dhr.mjs",
    "harness:build": "pnpm build",
    "harness:test": "pnpm test",
    "harness:quick": "pnpm typecheck && pnpm lint",
    "harness:bugfix": "pnpm test",
    "harness:full": "pnpm verify",
    "schemas:write": "pnpm build && node scripts/contracts-schema.mjs --write",
    "schemas:check": "node scripts/contracts-schema.mjs --check"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "esbuild": "0.28.0",
    "oxlint": "1.76.0",
    "typescript": "6.0.3"
  }
}
